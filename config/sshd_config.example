# MAW SSH Configuration Example for WSL2
# Place this in /etc/ssh/sshd_config (or a snippet in /etc/ssh/sshd_config.d/)

# Only listen on Tailscale interface for security
# Replace 100.x.x.x with your actual Tailscale IP
# ListenAddress 100.x.x.x
# Or listen on all interfaces if behind Tailscale firewall:
ListenAddress 0.0.0.0

Port 22
Protocol 2

# Authentication - keys only, no passwords
PasswordAuthentication no
PubkeyAuthentication yes
PermitRootLogin no
ChallengeResponseAuthentication no

# Allowed users (restrict to your username)
# AllowUsers your_username

# Security hardening
X11Forwarding no
PrintMotd no
AcceptEnv LANG LC_*
Subsystem sftp /usr/lib/openssh/sftp-server

# Keep connections alive for mobile networks
ClientAliveInterval 60
ClientAliveCountMax 3
TCPKeepAlive yes
