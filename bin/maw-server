#!/usr/bin/env bash
set -euo pipefail

# MAW Server - FastAPI daemon launcher

MAW_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Activate virtualenv if it exists
if [[ -d "$MAW_DIR/.venv" ]]; then
    source "$MAW_DIR/.venv/bin/activate"
fi

# Ensure maw is in PATH
export PATH="$MAW_DIR/bin:$PATH"

# Allow uvicorn to import mawlib.server from the maw installation dir
export PYTHONPATH="${MAW_DIR}:${PYTHONPATH:-}"

# Auto-initialize project if needed
# Check if we're in a git repo
if ! git rev-parse --git-dir > /dev/null 2>&1; then
  echo "[MAW] Error: Not a git repository. Please run in a git project directory."
  exit 1
fi

# Check if state.json exists, if not auto-init
if [[ ! -f ".maw/state.json" ]]; then
  echo "[MAW] Auto-initializing MAW with 4 agents..."
  maw init 4
elif [[ "$(maw status 2>/dev/null | grep -c 'ID')" == "0" ]]; then
  echo "[MAW] Auto-initializing MAW with 4 agents..."
  maw init 4
fi

# Start uvicorn (stay in project directory so server.py sees cwd as project root)
exec uvicorn mawlib.server:app --host 0.0.0.0 --port "${MAW_PORT:-8080}" --reload
