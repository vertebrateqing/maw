#!/usr/bin/env bash
set -euo pipefail

MAW_VERSION="0.2.3"
MAW_DIR="${MAW_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"

# Source libraries
source "${MAW_DIR}/lib/core.sh"
source "${MAW_DIR}/lib/state.sh"
source "${MAW_DIR}/lib/git.sh"
source "${MAW_DIR}/lib/ui.sh"

# maw_help - show usage information
maw_help() {
  local lang="${MAW_LANG:-en}"

  if [[ "$lang" == "zh" ]]; then
    cat << 'HELP'
用法: maw <命令> [选项]

命令:
  init [N]              初始化 MAW，创建 N 个代理 (默认 4)
  dispatch <任务> [id]  派发任务到空闲代理
  status                显示状态看板
  watch                 持续刷新状态看板
  review-request <id>   标记代理为待审核
  approve <id>          审核通过并合并到 main
  reject <id>           拒绝并重置代理
  diff <id>             查看代理的 git diff
  merge <id>            合并代理分支到 main
  reset                 一键重置所有代理
  reset <id>            重置单个代理到 main
  kill <id>             终止代理进程
  menu                  交互式菜单
  help                  显示帮助信息
  version               显示版本

环境变量:
  MAW_LANG          语言: en | zh (默认: en)

示例:
  maw init 6
  maw dispatch "重构认证模块"
  maw status
  maw diff 2
  maw approve 2
HELP
  else
    cat << 'HELP'
Usage: maw <command> [options]

Commands:
  init [N]              Initialize MAW with N agents (default: 4)
  dispatch <task> [id]  Dispatch task to an idle agent
  status                Show status board
  watch                 Continuously refresh status board
  review-request <id>   Mark agent as pending review
  approve <id>          Approve and merge agent into main
  reject <id>           Reject and reset agent
  diff <id>             Show agent git diff
  merge <id>            Merge agent branch into main
  reset                 Global reset: kill all, clear logs, sync with main
  reset <id>            Reset single agent to main
  kill <id>             Kill agent process
  menu                  Interactive menu
  help                  Show this help message
  version               Show version

Environment:
  MAW_LANG          Language: en | zh (default: en)

Examples:
  maw init 6
  maw dispatch "Refactor auth module"
  maw status
  maw diff 2
  maw approve 2
HELP
  fi
}

# maw_cmd_init <count>
maw_cmd_init() {
  local count="${1:-4}"
  local root
  root="$(maw_project_root)"

  maw_log info "Initializing MAW with ${count} agents..."
  maw_state_init

  for ((i=1; i<=count; i++)); do
    maw_git_worktree_create "$i"
    maw_state_add_agent "$i" "${root}/.agents/agent-${i}" "agent/${i}"
  done

  maw_log info "MAW initialized. Run 'maw status' to see the board."
}

# maw_cmd_dispatch <task> [agent_id]
maw_cmd_dispatch() {
  local task="$1"
  local agent_id="${2:-}"
  local root
  root="$(maw_project_root)"

  if [[ -z "$agent_id" ]]; then
    agent_id=$(maw_state_get_idle_agent)
    if [[ -z "$agent_id" ]]; then
      maw_die "No idle agents available. Run 'maw status' to check."
    fi
  fi

  local status
  status=$(maw_state_get_agent_status "$agent_id")
  if [[ "$status" != "idle" ]]; then
    maw_die "Agent ${agent_id} is not idle (status: ${status})"
  fi

  local worktree="${root}/.agents/agent-${agent_id}"
  local log_file="${root}/.maw/logs/agent-${agent_id}.log"
  maw_ensure_dir "$(dirname "$log_file")"

  maw_state_update_agent "$agent_id" "running" "$task"

  # Build the workflow-augmented prompt via the shared Python helper so the
  # bash CLI and the FastAPI dispatch path share a single template.
  local enhanced_task
  if ! enhanced_task=$(python3 "${MAW_DIR}/lib/build_prompt.py" "$agent_id" "$worktree" "$task"); then
    maw_state_update_agent "$agent_id" "idle" ""
    maw_die "Failed to build agent prompt"
  fi

  # Run claude via agent_wrapper for stream-json parsing
  python3 "${root}/lib/agent_wrapper.py" "$enhanced_task" "$worktree" "$log_file" > /dev/null 2>&1 &

  local pid=$!
  maw_state_update_agent "$agent_id" "running" "$task" "$pid"

  maw_log info "Dispatched task to agent-${agent_id} (PID: ${pid})"
}

# maw_cmd_status
maw_cmd_status() {
  local lang="${MAW_LANG:-en}"
  maw_ui_render_board "$lang"
}

# maw_cmd_watch
maw_cmd_watch() {
  local lang="${MAW_LANG:-en}"
  local interval="${MAW_WATCH_INTERVAL:-2}"

  while true; do
    clear
    maw_ui_render_board "$lang"
    echo ""
    if [[ "$lang" == "zh" ]]; then
      echo "按 Ctrl+C 退出"
    else
      echo "Press Ctrl+C to exit"
    fi
    sleep "$interval"
  done
}

# maw_cmd_merge <agent_id>
maw_cmd_merge() {
  local agent_id="$1"

  if maw_git_merge_agent "$agent_id"; then
    maw_state_update_agent "$agent_id" "idle" ""
    maw_log info "Agent ${agent_id} merged and reset to idle"
  fi
}

# maw_cmd_reset [agent_id]
# With agent_id: reset single agent (existing behavior)
# Without agent_id: global reset of all agents
maw_cmd_reset() {
  local agent_id="${1:-}"

  if [[ -n "$agent_id" ]]; then
    maw_git_worktree_reset "$agent_id"
    maw_state_update_agent "$agent_id" "idle" ""
    maw_log info "Agent ${agent_id} reset to main"
    return 0
  fi

  maw_cmd_reset_all
}

# maw_cmd_reset_all — one-shot reset of the entire workspace
maw_cmd_reset_all() {
  local root
  root="$(maw_project_root)"
  local state_file
  state_file="$(maw_state_file)"
  local lang="${MAW_LANG:-en}"

  if [[ "$lang" == "zh" ]]; then
    echo "【MAW 全局重置】"
  else
    echo "【MAW Global Reset】"
  fi

  # 1. Kill running processes
  local killed_count=0
  while IFS= read -r agent_json; do
    local id status pid
    id=$(echo "$agent_json" | jq -r '.id')
    status=$(echo "$agent_json" | jq -r '.status')
    pid=$(echo "$agent_json" | jq -r '.pid // empty')

    # Kill child processes first (claude), then parent (agent_wrapper)
    if [[ "$status" == "running" && -n "$pid" && "$pid" != "null" ]]; then
      if ps -p "$pid" > /dev/null 2>&1; then
        # Kill claude child before parent so it doesn't become orphan
        local child_pids
        child_pids=$(pgrep -P "$pid" 2>/dev/null || true)
        if [[ -n "$child_pids" ]]; then
          echo "$child_pids" | xargs -r kill -9 2>/dev/null || true
        fi

        kill "$pid" 2>/dev/null || true
        sleep 0.3
        kill -9 "$pid" 2>/dev/null || true

        maw_log info "Killed agent-${id} (PID: ${pid})"
        killed_count=$((killed_count + 1))
      fi
    fi

    # Safety: pkill any orphaned agent_wrapper/claude for this agent
    pkill -f "agent_wrapper.py.*agent-${id}" 2>/dev/null || true
    pkill -f "claude -p.*agent-${id}" 2>/dev/null || true
  done < <(jq -c '.agents[]' "$state_file" 2>/dev/null || true)

  if [[ "$lang" == "zh" ]]; then
    echo "  已终止 ${killed_count} 个运行中的 agent"
  else
    echo "  Killed ${killed_count} running agent(s)"
  fi

  # 2. Fetch origin/main
  echo ""
  if [[ "$lang" == "zh" ]]; then
    echo "  同步 origin/main..."
  else
    echo "  Fetching origin/main..."
  fi
  git -C "$root" fetch origin main 2>/dev/null || true

  # 3. Reset worktrees + report and clear logs
  echo ""
  if [[ "$lang" == "zh" ]]; then
    echo "  重置 worktree 和日志:"
  else
    echo "  Resetting worktrees and logs:"
  fi

  while IFS= read -r agent_json; do
    local id
    id=$(echo "$agent_json" | jq -r '.id')
    local worktree
    worktree="$(maw_agents_dir)/agent-${id}"

    # Force-clean any uncommitted changes before reset
    git -C "$worktree" checkout -- . 2>/dev/null || true
    git -C "$worktree" clean -fd 2>/dev/null || true

    # Reset worktree
    maw_git_worktree_reset "$id"

    # Report and clear log
    local log_file="${root}/.maw/logs/agent-${id}.log"
    if [[ -f "$log_file" ]]; then
      local lines
      lines=$(wc -l < "$log_file" | tr -d ' ')
      if [[ "$lang" == "zh" ]]; then
        printf "    agent-%s: 日志 %s 行 → 已清空\n" "$id" "$lines"
      else
        printf "    agent-%s: log %s lines → cleared\n" "$id" "$lines"
      fi
      : > "$log_file"
    else
      if [[ "$lang" == "zh" ]]; then
        printf "    agent-%s: 无日志\n" "$id"
      else
        printf "    agent-%s: no log\n" "$id"
      fi
    fi
  done < <(jq -c '.agents[]' "$state_file" 2>/dev/null || true)

  # 4. Reset state.json
  echo ""
  if [[ "$lang" == "zh" ]]; then
    echo "  重置状态..."
  else
    echo "  Resetting state..."
  fi

  local now
  now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  jq --arg ts "$now" \
     '.agents |= map(.status = "idle" | .task = "" | .pid = null | .started_at = null | .completed_at = $ts) | .pending_messages = []' \
     "$state_file" > "${state_file}.tmp"
  mv "${state_file}.tmp" "$state_file"

  # 5. Show final status
  echo ""
  maw_ui_render_board "$lang"

  if [[ "$lang" == "zh" ]]; then
    maw_log info "全局重置完成"
  else
    maw_log info "Global reset complete"
  fi
}

# maw_cmd_kill <agent_id>
maw_cmd_kill() {
  local agent_id="$1"
  local state_file
  state_file="$(maw_state_file)"
  local pid
  pid=$(jq -r ".agents[] | select(.id == ${agent_id}) | .pid // empty" "$state_file")

  if [[ -n "$pid" && "$pid" != "null" ]]; then
    kill "$pid" 2>/dev/null || kill -9 "$pid" 2>/dev/null || true
    maw_log info "Killed agent ${agent_id} (PID: ${pid})"
  fi

  maw_state_update_agent "$agent_id" "idle" ""
}

# maw_cmd_review_request <agent_id>
maw_cmd_review_request() {
  local agent_id="$1"
  maw_state_review_request "$agent_id"
}

# maw_cmd_approve <agent_id>
maw_cmd_approve() {
  local agent_id="$1"
  if maw_git_merge_agent "$agent_id"; then
    maw_state_update_agent "$agent_id" "idle" ""
    maw_log info "Agent ${agent_id} approved and merged"
  fi
}

# maw_cmd_reject <agent_id>
maw_cmd_reject() {
  local agent_id="$1"
  maw_git_worktree_reset "$agent_id"
  maw_state_update_agent "$agent_id" "idle" ""
  maw_log info "Agent ${agent_id} rejected and reset"
}

# maw_cmd_diff <agent_id>
maw_cmd_diff() {
  local agent_id="$1"
  local root
  root="$(maw_project_root)"
  git -C "$root" diff "main...agent/${agent_id}"
}

# maw_cmd_queue <content>
maw_cmd_queue() {
  local content="$1"
  local msg_id
  msg_id=$(maw_state_add_message "$content")
  echo "$msg_id"
  maw_log info "Message queued: ${msg_id}"
}

# maw_cmd_queue_update <id> <content>
maw_cmd_queue_update() {
  local id="$1"
  local content="$2"
  maw_state_update_message "$id" "$content"
  maw_log info "Message updated: ${id}"
}

# maw_cmd_queue_remove <id>
maw_cmd_queue_remove() {
  local id="$1"
  maw_state_remove_message "$id"
  maw_log info "Message removed: ${id}"
}

# maw_cmd_queue_list
maw_cmd_queue_list() {
  maw_state_list_messages
}

# maw_cmd_config <agent_id> <key> <value>
maw_cmd_config() {
  local agent_id="$1"
  local key="$2"
  local value="$3"

  local bool_value
  if [[ "$value" == "true" || "$value" == "1" ]]; then
    bool_value="true"
  else
    bool_value="false"
  fi

  maw_state_update_agent_config "$agent_id" "$key" "$bool_value"
  maw_log info "Agent ${agent_id} config updated: ${key}=${bool_value}"
}

# maw_cmd_menu
maw_cmd_menu() {
  local lang="${MAW_LANG:-en}"

  while true; do
    clear
    maw_ui_render_board "$lang"
    maw_ui_render_menu "$lang"

    read -r cmd args

    case "$cmd" in
      list|status)
        maw_ui_render_board "$lang"
        echo ""
        if [[ "$lang" == "zh" ]]; then
          echo "按 Enter 继续..."
        else
          echo "Press Enter to continue..."
        fi
        read -r
        ;;
      dispatch)
        if [[ -n "$args" ]]; then
          maw_cmd_dispatch "$args"
        else
          if [[ "$lang" == "zh" ]]; then
            echo "错误: 需要提供任务描述"
          else
            echo "Error: task description required"
          fi
          sleep 2
        fi
        ;;
      merge)
        if [[ -n "$args" ]]; then
          maw_cmd_merge "$args"
        else
          echo "Error: agent ID required"
          sleep 2
        fi
        ;;
      reset)
        if [[ -n "$args" ]]; then
          maw_cmd_reset "$args"
        else
          echo "Error: agent ID required"
          sleep 2
        fi
        ;;
      kill)
        if [[ -n "$args" ]]; then
          maw_cmd_kill "$args"
        else
          echo "Error: agent ID required"
          sleep 2
        fi
        ;;
      quit|exit|q)
        break
        ;;
      *)
        if [[ "$lang" == "zh" ]]; then
          echo "未知命令: $cmd"
        else
          echo "Unknown command: $cmd"
        fi
        sleep 1
        ;;
    esac
  done
}

# Main command dispatch
main() {
  local cmd="${1:-help}"
  shift || true

  case "$cmd" in
    init)
      maw_cmd_init "${1:-4}"
      ;;
    dispatch)
      if [[ $# -lt 1 ]]; then
        maw_die "Usage: maw dispatch <task> [agent-id]"
      fi
      maw_cmd_dispatch "$1" "${2:-}"
      ;;
    status)
      maw_cmd_status
      ;;
    watch)
      maw_cmd_watch
      ;;
    merge)
      if [[ $# -lt 1 ]]; then
        maw_die "Usage: maw merge <agent-id>"
      fi
      maw_cmd_merge "$1"
      ;;
    reset)
      maw_cmd_reset "${1:-}"
      ;;
    kill)
      if [[ $# -lt 1 ]]; then
        maw_die "Usage: maw kill <agent-id>"
      fi
      maw_cmd_kill "$1"
      ;;
    review-request)
      if [[ $# -lt 1 ]]; then
        maw_die "Usage: maw review-request <agent-id>"
      fi
      maw_cmd_review_request "$1"
      ;;
    approve)
      if [[ $# -lt 1 ]]; then
        maw_die "Usage: maw approve <agent-id>"
      fi
      maw_cmd_approve "$1"
      ;;
    reject)
      if [[ $# -lt 1 ]]; then
        maw_die "Usage: maw reject <agent-id>"
      fi
      maw_cmd_reject "$1"
      ;;
    diff)
      if [[ $# -lt 1 ]]; then
        maw_die "Usage: maw diff <agent-id>"
      fi
      maw_cmd_diff "$1"
      ;;
    queue)
      if [[ $# -lt 1 ]]; then
        maw_die "Usage: maw queue <content>"
      fi
      maw_cmd_queue "$1"
      ;;
    queue-update)
      if [[ $# -lt 2 ]]; then
        maw_die "Usage: maw queue-update <id> <content>"
      fi
      maw_cmd_queue_update "$1" "$2"
      ;;
    queue-remove)
      if [[ $# -lt 1 ]]; then
        maw_die "Usage: maw queue-remove <id>"
      fi
      maw_cmd_queue_remove "$1"
      ;;
    queue-list)
      maw_cmd_queue_list
      ;;
    config)
      if [[ $# -lt 3 ]]; then
        maw_die "Usage: maw config <agent-id> <key> <value>"
      fi
      maw_cmd_config "$1" "$2" "$3"
      ;;
    menu)
      maw_cmd_menu
      ;;
    help|-h|--help)
      maw_help
      ;;
    version|-v|--version)
      echo "maw version ${MAW_VERSION}"
      ;;
    *)
      maw_die "Unknown command: $cmd. Run 'maw help' for usage."
      ;;
  esac
}

main "$@"
